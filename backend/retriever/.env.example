# ---------- Language model ----------
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Qdrant (search index) ----------
# Use https:// when QDRANT_API_KEY is set: the key is sent with every request.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------- Encryption of chat text at rest ----------
# One or more Fernet keys, comma separated. The FIRST one encrypts, all decrypt.
# Make one with: python crypto.py genkey
# Back it up: if it is lost, the stored chats cannot be read again.
CHAT_ENCRYPTION_KEYS=your_encryption_keys_here

# ---------- Who may talk to this service ----------
# Listen on this machine only by default. Use 0.0.0.0 in Docker / on a server,
# and then ALSO set the token and TLS below.
CHAT_BIND_HOST=127.0.0.1
CHAT_SERVICE_PORT=50051
# The orchestrator sends this with every call (same value in its .env)
CHAT_SERVICE_TOKEN=change_me
# TLS (file paths). CHAT_TLS_CLIENT_CA turns on mutual TLS.
CHAT_TLS_CERT=
CHAT_TLS_KEY=
CHAT_TLS_CLIENT_CA=

# ---------- Optional tuning ----------
# CHAT_DB_PATH=./chat.db
# RETRIEVAL_MIN_SIMILARITY=0.79
# PROMPT_BUDGET_CHARS=24000
# Most document names told to the model when the user chose no document
# MAX_AVAILABLE_DOCUMENTS=50
