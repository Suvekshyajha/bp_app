# Copy to .env and fill in. Never commit the real .env.

# Required: embeddings come from the Google Gemini API. Same key as the retriever.
# On the free tier Google may use what is sent to improve its products: do not
# upload real personal or sensitive documents with a free key.
GEMINI_API_KEY=your_key_here

# Same Qdrant as the retriever
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Must be EXACTLY the same keys as the retriever (the filenames and chunk text are encrypted)
CHAT_ENCRYPTION_KEYS=

# Required. Same value in the orchestrator's .env.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SERVICE_TOKEN=

# Where the gRPC service listens. Keep it on this machine or an internal network.
INGEST_BIND_HOST=127.0.0.1
INGEST_PORT=8100
# Optional TLS (file paths, set both)
# INGEST_TLS_CERT=
# INGEST_TLS_KEY=

# Development only, localhost only: start without a token
# INGEST_ALLOW_NO_AUTH=true

# Stage 1 (the LLM that picks a chunking strategy). Without a key, or with
# INGEST_ANALYSIS_ENABLED=false, fixed rules choose the strategy instead.
GROQ_API_KEY=
# INGEST_ANALYSIS_MODEL=openai/gpt-oss-120b
# INGEST_ANALYSIS_ENABLED=true

# Limits
# MAX_UPLOAD_MB=10
# MAX_DOCS_PER_USER=20
# INGEST_SEMANTIC_MAX_CHARS=80000
# INGEST_SEMANTIC_PERCENTILE=90
# INGEST_JOB_TIMEOUT_SECONDS=300

# Files
# INGEST_DB_PATH=./ingest.db
# INGEST_UPLOAD_DIR=./data/uploads

# Optional: a Postgres address (for example from Neon) used instead of the
# SQLite file. Give all three services the same one. It holds a password.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
