# ---------- Chat service connection ----------
CHAT_SERVICE_ADDRESS=localhost:50051
# Must match CHAT_SERVICE_TOKEN of the chat service (the retriever folder).
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAT_SERVICE_TOKEN=change_me
# TLS to the chat service (see backend/README.md). Leave empty on one machine.
CHAT_TLS_CA=
CHAT_TLS_CLIENT_CERT=
CHAT_TLS_CLIENT_KEY=

# ---------- Login ----------
SESSION_MINUTES=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployed on https with the frontend on another site: true / none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------- Rate limit ----------
CHAT_RATE_LIMIT_MESSAGES=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Documents (ingestion service) ----------
# Where the ingestion service listens (gRPC)
INGEST_SERVICE_ADDRESS=localhost:8100
# Must match INGEST_SERVICE_TOKEN of the ingestion service (backend/ingestion/.env).
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SERVICE_TOKEN=change_me
# Certificate that signed the ingestion service's certificate. Leave empty on one machine.
INGEST_TLS_CA=
MAX_UPLOAD_MB=10
# Uploads per user in 60 seconds
DOC_UPLOAD_RATE_LIMIT=5

# Optional: a Postgres address (for example from Neon) used instead of the
# SQLite file. Give all three services the same one. It holds a password.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
